# ============================================================
#  .env.example —— 範本，沒有任何真實金鑰
#
#  使用方式（PC 或 NAS 上都一樣）：
#      cp .env.example .env   然後把每個 = 後面填上自己的值
#
#  .env 已被 .gitignore 擋住，不會被 commit。
#  新增欄位時請兩份一起改。
# ============================================================

# ============================================================
#  Homepage 金鑰與位址設定
#
#  config/*.yaml 用 {HOMEPAGE_VAR_名稱} 引用這裡的值，
#  所以那些 yaml 可以安心備份／分享，機密只集中在這一個檔案。
#
#  ⚠️ 這個檔案不要進 Git、不要放雲端同步資料夾。
#     本資料夾的 .gitignore 已排除 .env（只有 .env.example 進版控）。
#
#
#  ⚠️ 重要陷阱：值裡面的 $ 必須寫成 $$
#     Docker Compose 會對這個檔案的值做變數展開，$ 後面會被當成變數名稱，
#     未定義就展開成空字串 —— 密碼會被「無聲截斷」，不會有任何錯誤訊息。
#     實際踩過的案例：18 字元密碼變成 13 字元、8 字元變成 3 字元，
#     Homepage 拿半截密碼每次輪詢都驗證失敗，結果被 NAS 判定為暴力破解而封鎖 IP。
#     => 密碼裡有 $ 就寫成 $$（目前 NC_PASS / DSM_PASS / QNAP_PASS 已如此處理）。
#     驗證方法：docker exec homepage sh -c 'echo ${#HOMEPAGE_VAR_DSM_PASS}'
#               印出的長度要跟你的真實密碼一樣長。
#  小知識：Homepage 的 HTTPS 連線一律 rejectUnauthorized: false
#         （原始碼 src/utils/proxy/http.js），所以 Synology / QNAP 的
#         自簽憑證直接就能用，不需要任何額外設定。
#         => 請一律填 HTTPS 埠，密碼才不會在區網裡裸奔。
# ============================================================


# ============================================================
#  位址
# ============================================================
# PC：這台電腦有兩個 IP —— .11 是有線、.13 是 Wi-Fi。
#     選有線比較穩。（注意：舊設定裡的 .147 是錯的，那個 IP 不存在）
HOMEPAGE_VAR_PC=

# Synology SA6400
HOMEPAGE_VAR_NAS=

# QNAP TS-253-Pro
HOMEPAGE_VAR_QNAP=

# ASUS 路由器（Deco 三台是 AP 模式）
HOMEPAGE_VAR_ROUTER=

# Deco 主機（客廳）。另兩台 .3 主臥 / .4 閣樓 也有網頁介面，
# 但 Mesh 設定集中在主機上，通常只需要這一台。
HOMEPAGE_VAR_DECO=

# N8N 網址
HOMEPAGE_VAR_N8N=


# ============================================================
#  Immich  (NAS:2283)
#  取得：Immich → 帳戶設定 → API 金鑰 → 新增
# ------------------------------------------------------------
#  ✅ 只勾一個權限：server.statistics
#     其他 60 幾個權限全部不要勾。
#
#  ⚠️ 必須用「管理員帳號」建立。原始碼裡的限制是：
#     @Authenticated({ permission: Permission.ServerStatistics, admin: true })
#     普通使用者的金鑰即使勾了 server.statistics 也會被拒絕。
#
#  好消息：因為只勾一個權限，這把金鑰即使外流也只能查
#         「幾張照片 / 幾部影片 / 用了多少空間」，
#         讀不到照片、刪不了東西、改不了設定。
# ============================================================
HOMEPAGE_VAR_IMMICH_KEY=


# ============================================================
#  Home Assistant  (NAS:8123)
#  取得：個人資料 → 安全性 → 長期存取權杖 → 建立權杖
# ------------------------------------------------------------
#  ⚠️ 權杖會繼承「建立它的那個使用者」的全部權限。
#     用管理員帳號建立 = 給出全權。
#     建議另建一個非管理員使用者，再用它產生權杖。
#
#  這也是所有 IoT 資料的入口：Homepage 不會直接跟 Tapo 插座、
#  Roborock、紅外線發射器講話，全部透過 HA 的 entity 撈出來。
#  entity_id 查法：HA → 開發者工具 → 狀態
# ============================================================
HOMEPAGE_VAR_HASS_TOKEN=


# ============================================================
#  Nextcloud  (NAS:8080)
# ------------------------------------------------------------
#  ⚠️ 密碼請用「應用程式密碼」，不要用登入密碼。
#     取得：Nextcloud → 個人設定 → 安全性 → 建立新的應用程式密碼
#     好處：可以單獨撤銷，不影響你的主帳號登入。
# ============================================================
HOMEPAGE_VAR_NC_USER=
HOMEPAGE_VAR_NC_PASS=


# ============================================================
#  Uptime Kuma  (NAS:3001)
# ------------------------------------------------------------
#  ✅ 不需要任何金鑰或密碼，只要一個公開狀態頁的 slug。
#     取得：Uptime Kuma → 設定 → 狀態頁 → 新增狀態頁，
#           網址 /status/xxxxx 裡的 xxxxx 就是 slug。
#     這是所有 widget 裡最安全的一個。
# ============================================================
HOMEPAGE_VAR_KUMA_SLUG=


# ============================================================
#  Calibre-Web  (NAS:8083)
# ------------------------------------------------------------
#  ⚠️ 就是登入帳密，沒有權限分級。建議建一個只有讀取權限的
#     專用使用者（Calibre-Web 後台可以取消勾選各種權限）。
# ============================================================
HOMEPAGE_VAR_CALIBRE_USER=
HOMEPAGE_VAR_CALIBRE_PASS=


# ============================================================
#  AdGuard Home  (NAS:81)
#  widget 型別 adguard，可顯示 queries / blocked / filtered / latency
# ------------------------------------------------------------
#  帳密就是 AdGuard Home 網頁介面的登入帳密，沒有權限分級。
#
#  ⚠️ 填好之後，要去 services.yaml 把 AdGuard 那段 widget 的註解拿掉才會生效。
#     留空就啟用 widget 會造成無限重試驗證失敗 —— 那正是先前 IP 被封鎖的成因。
# ============================================================
HOMEPAGE_VAR_ADGUARD_USER=
HOMEPAGE_VAR_ADGUARD_PASS=


# ============================================================
#  Synology DSM  (NAS:5001，務必用 HTTPS)
# ------------------------------------------------------------
#  widget 呼叫的三個 API，全部是管理員專屬：
#    SYNO.Core.System              info                  型號 / 開機時間
#    SYNO.Core.System              info&type="storage"   磁碟區容量
#    SYNO.Core.System.Utilization  get                   CPU / 記憶體
#
#  ⚠️ 必須加入 administrators 群組，沒有替代方案。
#  ⚠️ 不能啟用 2FA —— widget 不支援。
#
#  建立步驟（DSM 7：控制台 → 使用者與群組 → 使用者 → 新增）：
#    1. 名稱 homepage，密碼用長隨機字串（不要與任何現有密碼重複）
#    2. 群組：勾選 administrators（必要，不勾 widget 會失敗）
#    3. 共用資料夾權限：全部設為「沒有存取權限」
#    4. 應用程式權限：全部拒絕，只保留 DSM
#    5. 不要啟用 2FA
#    6. 勾「不允許使用者變更帳號密碼」
#
#  ⚠️ 老實說：第 3、4 步是縱深防禦，不是硬性邊界。
#     管理員帳號本身就有權限把那些限制改回來。
#     它們的實際價值是擋住「抓了帳密就自動撈資料」的腳本，
#     以及避免自己誤操作。真正的保護只有兩件事：
#       (1) 密碼夠長夠隨機、絕不重複使用
#       (2) 密碼只存在這個檔案裡，而這個檔案被 .gitignore 擋住
#
#  不想放管理員密碼的替代方案：
#     把 services.yaml 裡 Synology 那段的 widget: 整塊刪掉，
#     只留 href。點下去照樣進 DSM，什麼都不用填。
#     代價是少了 CPU / 記憶體 / 開機時間 / 磁碟區剩餘空間四個數字。
# ============================================================
HOMEPAGE_VAR_DSM_USER=
HOMEPAGE_VAR_DSM_PASS=


# ============================================================
#  QNAP  (NAS2:443，務必用 HTTPS)
# ------------------------------------------------------------
#  widget 呼叫的三個路徑：
#    cgi-bin/authLogin.cgi                                  登入
#    cgi-bin/management/manaRequest.cgi?subfunc=sysinfo     CPU/記憶體/溫度
#    cgi-bin/management/chartReq.cgi?chart_func=disk_usage  磁碟用量
#
#  後兩個在 /management/ 底下，是 QTS 管理員介面 => 需要管理員權限。
#
#  ⚠️ 登入時密碼只做 base64 編碼 —— 那是編碼不是加密，等於明文。
#     所以絕對要用 HTTPS(443)，不要用 HTTP(8080)。
#  ⚠️ 不能啟用 2 步驟驗證。
#
#  建立步驟（QTS：控制台 → 權限設定 → 使用者 → 新增使用者）：
#    1. 名稱 homepage，長隨機密碼
#    2. 使用者群組：加入 administrators
#    3. 共用資料夾權限：全部設「拒絕存取」
#    4. 不要啟用 2 步驟驗證
#
#  同上：不想放管理員密碼就把 services.yaml 裡 QNAP 那段的
#        widget: 刪掉，只留 href。
# ============================================================
HOMEPAGE_VAR_QNAP_USER=
HOMEPAGE_VAR_QNAP_PASS=
